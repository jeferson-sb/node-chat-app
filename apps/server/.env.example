PORT=5000
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/dbname
BETTER_AUTH_SECRET=your_secret
BETTER_AUTH_URL=http://localhost:3000

# Set to run multiple server instances behind a load balancer with a
# shared room roster and cross-node broadcast (see docker-compose.yml).
# Leave unset for a single-process/local-dev server.
# REDIS_URL=redis://localhost:6379

# Pino log level (trace/debug/info/warn/error/fatal). Defaults to info.
# LOG_LEVEL=info