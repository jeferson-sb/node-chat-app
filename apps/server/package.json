{
  "name": "@chatme/server",
  "version": "1.0.0",
  "description": "Chat app server built with Express & Socket.io",
  "license": "MIT",
  "author": "Jeferson S. Brito",
  "type": "module",
  "main": "src/presentation/server.ts",
  "scripts": {
    "start": "node src/presentation/server.ts",
    "dev": "node --watch src/presentation/server.ts",
    "db:migrate": "better-auth migrate -y",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "better-auth": "^1.6.26",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "morgan": "^1.10.1",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "socket.io-adapter": "^2.5.8",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@electric-sql/pglite": "^0.5.4",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "kysely": "^0.29.5",
    "kysely-pglite-dialect": "^1.3.1",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
