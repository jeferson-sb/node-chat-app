PORT=5000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatme

# generate a real one for anything else with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me
BETTER_AUTH_URL=http://localhost:5000
CLIENT_APP_URL=http://localhost:5173

# Set to run multiple server instances behind a load balancer with a
# shared room roster and cross-node broadcast (see docker-compose.yml).
# Leave unset for a single-process/local-dev server.
# REDIS_URL=redis://localhost:6379

# Pino log level (trace/debug/info/warn/error/fatal). Defaults to info.
# LOG_LEVEL=info
